VITE_API_BASE_URL=http://localhost:8080
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_OFFLINE_STATIC_GEO_URLS=

# 개발 서버에서만 사용한다. 로컬 DB의 mock 백운대 코스 ID에 맞춘다.
VITE_MOCK_BAEGUNDAE_COURSE_ID=2
# 사진 스팟은 기본적으로 실제 API를 사용한다. 예시 2개만 확인할 때 개발 서버에서 mock으로 지정한다.
VITE_COURSE_PHOTO_SPOTS_SOURCE=api
# 백운대 분석이 개발용 시드(코스 1/산 1) 대신 별도 로컬 DB에 있으면 두 ID를 함께 지정한다.
# VITE_MOCK_BAEGUNDAE_ANALYSIS_COURSE_ID=2
# VITE_MOCK_BAEGUNDAE_ANALYSIS_MOUNTAIN_ID=2
# 개발 서버에서만 사용한다. true면 코스에서 멀리 있어도 등산을 시작할 수 있다(사무실 테스트용).
VITE_HIKE_START_ANYWHERE=false
