{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/inject-precache.mjs",
    "lint": "oxlint",
    "test:picker": "node --experimental-strip-types --test tests/date-time-picker.test.mjs",
    "test:hiking": "node --experimental-strip-types --test tests/hiking-status.test.mjs",
    "test:hike-tracking": "node --experimental-strip-types --test tests/hike-tracking.test.mjs",
    "test:profile": "node --experimental-strip-types --test tests/hike-profile.test.mjs",
    "test:offline": "node --test tests/service-worker.test.cjs",
    "test:home": "node --test tests/home-discovery.test.mjs",
    "test:courses": "node --test tests/course-discovery.test.mjs",
    "test:course-detail": "node --test tests/course-detail.test.mjs",
    "test:terrain": "node --experimental-strip-types --test tests/map-terrain.test.mjs",
    "test:facilities": "node --experimental-strip-types --test tests/facilities.test.mjs",
    "test:course-facilities": "node --experimental-strip-types --test tests/course-facilities.test.mjs tests/course-facilities-view.test.mjs",
    "test:sheets": "node --experimental-strip-types --test tests/map-sheet-geometry.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.3.1",
    "echarts": "^6.1.0",
    "maplibre-gl": "^6.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
