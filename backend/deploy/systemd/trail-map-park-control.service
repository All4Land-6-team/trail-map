[Unit]
Description=Collect KNPS office controls for Trail Map
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=2h
StartLimitBurst=2

[Service]
Type=oneshot
User=trail-map
Group=trail-map
WorkingDirectory=/opt/trail-map
EnvironmentFile=/etc/trail-map/park-control.env
ExecStart=/usr/bin/java -jar /opt/trail-map/trail-map-backend.jar --spring.main.web-application-type=none --spring.flyway.enabled=false --park-control.import.enabled=true --park-control.import.upload=true
TimeoutStartSec=15min
Restart=on-failure
RestartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
